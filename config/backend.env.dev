# Backend Development Configuration (PC)
ENVIRONMENT=development
DEV_MODE=true

# Database (PostgreSQL for dev to match production)
DATABASE_URL=postgresql+asyncpg://aads:aads_secure_pass@postgres:5432/aads

# Redis
REDIS_URL=redis://redis:6379/0

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=aads_influx_token
INFLUXDB_ORG=aads
INFLUXDB_BUCKET=aads_metrics

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=aads-data

# Ollama
OLLAMA_BASE_URL=http://navi:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# Mock Data Sources (dev)
NMEA_ENABLED=true
NMEA_SERIAL_PORT=/dev/ttyUSB0
NMEA_BAUD_RATE=4800
NMEA_TIMEOUT=1.0
NMEA_MOCK_DATA=true

SIGNALK_ENABLED=true
SIGNALK_SERVER_URL=ws://signalk:3000/signalk/v1/stream
SIGNALK_MOCK_DATA=true
SIGNALK_UPDATE_INTERVAL=1.0
SIGNALK_TIMEOUT=10.0

CAMERA_DEVICE_ID=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
MOCK_CAMERA=true

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/aads.log
LOG_JSON=true

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security (dev only)
SECRET_KEY=dev-secret-key-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

