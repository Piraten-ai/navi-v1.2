# AADS Backend Configuration

# Environment
ENVIRONMENT=development
DEV_MODE=true
MOCK_CAMERA=true

# Database (PostgreSQL recommended for dev and production)
DATABASE_URL=postgresql+asyncpg://aads:aads_secure_pass@postgres:5432/aads

# Redis
REDIS_URL=redis://localhost:6379/0

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=aads
INFLUXDB_BUCKET=telemetry

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=aads-data

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=120

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/aads.log
LOG_JSON=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Camera
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
CAMERA_DEVICE_ID=0

# YOLO Detection
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45

# NMEA GPS Configuration
NMEA_ENABLED=true
NMEA_SERIAL_PORT=/dev/ttyUSB0
NMEA_BAUD_RATE=4800
NMEA_TIMEOUT=1.0
NMEA_MOCK_DATA=true
NMEA_UPDATE_INTERVAL=1.0

# Signal K Configuration
SIGNALK_ENABLED=true
SIGNALK_SERVER_URL=ws://localhost:3000/signalk/v1/stream
SIGNALK_MOCK_DATA=true
SIGNALK_UPDATE_INTERVAL=1.0
SIGNALK_TIMEOUT=10.0
