[Unit]
Description=AADS Native UI (Qt)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/aads/frontend-qt
EnvironmentFile=/opt/aads/frontend-qt/aads-ui.env
ExecStart=/opt/aads/frontend-qt/build/aads_ui
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
